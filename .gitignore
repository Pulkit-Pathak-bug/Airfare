# The fare database. Regenerated by the collector; not shared through git.
# Everyone downstream uses data/fares_export.csv instead.
*.db
*.db-wal
*.db-shm

# Secrets. Never commit an API key.
.env
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# IndiGo credentials. Short-lived, and never committed.
.indigo_token
.indigo_cookie

# Akasa credentials
.akasa_token

# Air India credentials
.airindia_token
.airindia_cookie

# SpiceJet credentials
.spicejet_token

# Catch-all for the same pattern, so a credential file added for a new
# carrier is ignored by default rather than by remembering to add it here.
.*_token
.*_cookie

# Generated documents. Rebuilt from the data store by make_*.py, so the
# PDFs are outputs, not source — and the internal ones (defence pack,
# code walkthrough, checklist) are team material rather than deliverables.
# The generators stay tracked: they are what proves the figures are
# computed rather than typed.
docs/*.pdf
docs/*.html
